generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users         User[]
  homes         Home[]
  personTags    PersonTag[]
  categories    Category[]
  categoryRules CategoryRule[]
  accounts      Account[]
  transactions  Transaction[]
  importBatches ImportBatch[]
  contacts      Contact[]
  loans         Loan[]
  invites       Invite[]

  @@map("households")
}

model User {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())

  personTag PersonTag?

  @@index([householdId])
  @@map("users")
}

model Home {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String
  isActive    Boolean   @default(true)

  transactionHomes TransactionHome[]

  @@index([householdId])
  @@map("homes")
}

model PersonTag {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String
  isActive    Boolean   @default(true)
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  transactionPersonTags TransactionPersonTag[]
  spentTransactions     Transaction[]
  invites               Invite[]

  @@index([householdId])
  @@map("person_tags")
}

enum CategoryKind {
  income
  expense
}

model Category {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id])
  name        String
  kind        CategoryKind
  isSystem    Boolean      @default(false)
  isActive    Boolean      @default(true)
  parentId    String?
  parent      Category?    @relation("CategoryToParent", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryToParent")

  categoryRules CategoryRule[]
  transactions  Transaction[]

  @@index([householdId])
  @@map("categories")
}

// A description-text match rule that auto-assigns a category (e.g. "contains
// SWIGGY" -> Dining Out). categoryId is nullable: a rule can be detected via
// matching before a category has been picked for it (needs_review).
model CategoryRule {
  id          String              @id @default(cuid())
  householdId String
  household   Household           @relation(fields: [householdId], references: [id])
  name        String
  matchText   String
  matchType   MatchType
  categoryId  String?
  category    Category?           @relation(fields: [categoryId], references: [id])
  source      CategoryRuleSource?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())

  transactions Transaction[]

  @@index([householdId])
  @@map("category_rules")
}

enum MatchType {
  exact
  contains
}

enum CategoryRuleSource {
  user_defined
  learned
}

enum AccountType {
  bank
  card
  wallet
  cash
}

model Account {
  id          String      @id @default(cuid())
  householdId String
  household   Household   @relation(fields: [householdId], references: [id])
  name        String
  type        AccountType
  institution String?
  last4       String?
  isActive    Boolean     @default(true)

  transactions Transaction[]

  @@index([householdId])
  @@map("accounts")
}

enum CategoryStatus {
  confirmed
  auto_mapped
  needs_review
  unmapped
}

enum TransactionSource {
  manual
  csv
  pdf
}

model Transaction {
  id             String            @id @default(cuid())
  householdId    String
  household      Household         @relation(fields: [householdId], references: [id])
  accountId      String
  account        Account           @relation(fields: [accountId], references: [id])
  categoryId     String?
  category       Category?         @relation(fields: [categoryId], references: [id])
  categoryStatus CategoryStatus    @default(unmapped)
  categoryRuleId String?
  categoryRule   CategoryRule?     @relation(fields: [categoryRuleId], references: [id])
  spentByPersonTagId String?
  spentByPersonTag   PersonTag?    @relation(fields: [spentByPersonTagId], references: [id])
  amount         Decimal           @db.Decimal(12, 2)
  date           DateTime
  description    String
  notes          String?
  source         TransactionSource
  importBatchId  String?
  importBatch    ImportBatch?      @relation(fields: [importBatchId], references: [id])
  rawPayload     Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  loan  Loan?
  homes  TransactionHome[]
  people TransactionPersonTag[]

  @@index([householdId, date])
  @@index([householdId, categoryStatus])
  @@map("transactions")
}

model TransactionHome {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  homeId        String
  home          Home        @relation(fields: [homeId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)

  @@unique([transactionId, homeId])
  @@index([homeId])
  @@map("transaction_homes")
}

model TransactionPersonTag {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  personTagId   String
  personTag     PersonTag   @relation(fields: [personTagId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)

  @@unique([transactionId, personTagId])
  @@index([personTagId])
  @@map("transaction_person_tags")
}

model ImportBatch {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  fileName    String
  source      String
  importedAt  DateTime  @default(now())

  transactions Transaction[]

  @@index([householdId])
  @@map("import_batches")
}

model Contact {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String
  phone       String?
  notes       String?

  loans Loan[]

  @@index([householdId])
  @@map("contacts")
}

enum LoanDirection {
  lent
  borrowed
}

enum LoanStatus {
  open
  settled
}

model Loan {
  id                  String        @id @default(cuid())
  householdId         String
  household           Household     @relation(fields: [householdId], references: [id])
  contactId           String
  contact             Contact       @relation(fields: [contactId], references: [id])
  direction           LoanDirection
  openingAmount       Decimal       @db.Decimal(12, 2)
  date                DateTime
  notes               String?
  status              LoanStatus    @default(open)
  linkedTransactionId String?       @unique
  linkedTransaction   Transaction?  @relation(fields: [linkedTransactionId], references: [id])

  repayments LoanRepayment[]

  @@index([householdId])
  @@map("loans")
}

enum InviteStatus {
  pending
  accepted
  expired
}

model Invite {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id])
  personTagId String
  personTag   PersonTag    @relation(fields: [personTagId], references: [id])
  email       String
  token       String       @unique
  status      InviteStatus @default(pending)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  @@index([householdId])
  @@index([personTagId])
  @@map("invites")
}

model LoanRepayment {
  id     String   @id @default(cuid())
  loanId String
  loan   Loan     @relation(fields: [loanId], references: [id])
  amount Decimal  @db.Decimal(12, 2)
  date   DateTime
  notes  String?

  @@index([loanId])
  @@map("loan_repayments")
}
