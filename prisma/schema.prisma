generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users         User[]
  homes         Home[]
  personTags    PersonTag[]
  categories    Category[]
  vendorRules   VendorRule[]
  accounts      Account[]
  transactions  Transaction[]
  importBatches ImportBatch[]
  contacts      Contact[]
  loans         Loan[]

  @@map("households")
}

model User {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())

  @@index([householdId])
  @@map("users")
}

model Home {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String
  isActive    Boolean   @default(true)

  transactions Transaction[]

  @@index([householdId])
  @@map("homes")
}

model PersonTag {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String
  isActive    Boolean   @default(true)

  transactions Transaction[]

  @@index([householdId])
  @@map("person_tags")
}

enum CategoryKind {
  income
  expense
}

model Category {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id])
  name        String
  kind        CategoryKind
  isSystem    Boolean      @default(false)
  isActive    Boolean      @default(true)
  parentId    String?
  parent      Category?    @relation("CategoryToParent", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryToParent")

  vendorRules  VendorRule[]
  transactions Transaction[]

  @@index([householdId])
  @@map("categories")
}

enum VendorMatchType {
  exact
  contains
}

enum VendorRuleSource {
  user_defined
  learned
}

model VendorRule {
  id          String           @id @default(cuid())
  householdId String
  household   Household        @relation(fields: [householdId], references: [id])
  matchText   String
  matchType   VendorMatchType
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  source      VendorRuleSource
  createdAt   DateTime         @default(now())

  @@index([householdId])
  @@map("vendor_rules")
}

enum AccountType {
  bank
  card
  wallet
}

model Account {
  id          String      @id @default(cuid())
  householdId String
  household   Household   @relation(fields: [householdId], references: [id])
  name        String
  type        AccountType
  institution String?
  last4       String?
  isActive    Boolean     @default(true)

  transactions Transaction[]

  @@index([householdId])
  @@map("accounts")
}

enum CategoryStatus {
  confirmed
  auto_mapped
  needs_review
  unmapped
}

enum TransactionSource {
  manual
  csv
  pdf
}

model Transaction {
  id             String            @id @default(cuid())
  householdId    String
  household      Household         @relation(fields: [householdId], references: [id])
  accountId      String
  account        Account           @relation(fields: [accountId], references: [id])
  categoryId     String?
  category       Category?         @relation(fields: [categoryId], references: [id])
  categoryStatus CategoryStatus    @default(unmapped)
  personTagId    String?
  personTag      PersonTag?        @relation(fields: [personTagId], references: [id])
  homeId         String?
  home           Home?             @relation(fields: [homeId], references: [id])
  amount         Decimal           @db.Decimal(12, 2)
  date           DateTime
  description    String
  notes          String?
  source         TransactionSource
  importBatchId  String?
  importBatch    ImportBatch?      @relation(fields: [importBatchId], references: [id])
  rawPayload     Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  loan Loan?

  @@index([householdId, date])
  @@index([householdId, categoryStatus])
  @@map("transactions")
}

model ImportBatch {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  fileName    String
  source      String
  importedAt  DateTime  @default(now())

  transactions Transaction[]

  @@index([householdId])
  @@map("import_batches")
}

model Contact {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String
  phone       String?
  notes       String?

  loans Loan[]

  @@index([householdId])
  @@map("contacts")
}

enum LoanDirection {
  lent
  borrowed
}

enum LoanStatus {
  open
  settled
}

model Loan {
  id                  String        @id @default(cuid())
  householdId         String
  household           Household     @relation(fields: [householdId], references: [id])
  contactId           String
  contact             Contact       @relation(fields: [contactId], references: [id])
  direction           LoanDirection
  openingAmount       Decimal       @db.Decimal(12, 2)
  date                DateTime
  notes               String?
  status              LoanStatus    @default(open)
  linkedTransactionId String?       @unique
  linkedTransaction   Transaction?  @relation(fields: [linkedTransactionId], references: [id])

  repayments LoanRepayment[]

  @@index([householdId])
  @@map("loans")
}

model LoanRepayment {
  id     String   @id @default(cuid())
  loanId String
  loan   Loan     @relation(fields: [loanId], references: [id])
  amount Decimal  @db.Decimal(12, 2)
  date   DateTime
  notes  String?

  @@index([loanId])
  @@map("loan_repayments")
}
